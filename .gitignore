__pycache__/
*.pyc
.DS_Store
vendor/
engine/fast.so

# Raw market data from Databento (CME): its licence forbids republishing it, so it lives in the private repo drusiyani/argon-data.
# The manifests (file names + sha256) stay public so the research can still be audited.
data/databento/
data/lockbox2010/*
!data/lockbox2010/MANIFEST.json
data/extra/*
!data/extra/MANIFEST.json

# HistData.com files: no published licence to redistribute, so they live in the private repo too (Nov 2026).
data/histdata/*
!data/histdata/MANIFEST.json
